# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Admin dashboard password ──────────────────────────────────────────────────
# Choose any strong password. This is checked client-side for simplicity.
VITE_ADMIN_PASSWORD=choose-a-strong-password-here

# ── Stripe payments (optional) ────────────────────────────────────────────────
# Until BOTH keys are set, the rental form falls back to the inquiry flow (no
# charge). Find these in: Stripe dashboard → Developers → API keys.
# Publishable key is safe in the browser; secret key must stay server-only.
# Also: verify your domain in Stripe (Settings → Payments) to enable Apple Pay.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_SECRET_KEY=sk_live_or_test_xxx
